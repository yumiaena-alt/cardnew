# Panelo — 환경변수 템플릿
#
# 사용법
#   1) 공개 값(NEXT_PUBLIC_*)과 로컬 기본값 → `.env` (git 추적 대상)
#   2) 시크릿(secret / service_role / api key) → `.env.local` (git 무시 대상)
#
# ⚠️ 시크릿을 `.env`에 넣지 않는다. 이 파일에는 실제 값을 절대 채우지 않는다.
# 모든 변수는 `src/libs/Env.ts`에서 Zod로 검증한다. `process.env`를 직접 읽지 않는다.

# ──────────────────────────────────────────────────────────────
# App
# ──────────────────────────────────────────────────────────────
NEXT_PUBLIC_APP_URL=http://localhost:3000
NEXT_TELEMETRY_DISABLED=1

# ──────────────────────────────────────────────────────────────
# i18n (next-intl)
# 지원 로케일: ko(기본), en / localePrefix: as-needed
# 코드 기본값은 src/utils/AppConfig.ts. 아래는 배포 환경별 재정의용.
# ──────────────────────────────────────────────────────────────
NEXT_PUBLIC_DEFAULT_LOCALE=ko
NEXT_PUBLIC_SUPPORTED_LOCALES=ko,en

# ──────────────────────────────────────────────────────────────
# Database — Supabase (PostgreSQL) + Drizzle
# 로컬 개발은 PGlite가 자동 기동되므로 비워둬도 된다.
# 운영/스테이징은 Supabase pooler(6543, pgbouncer) URL을 사용한다.
#   postgresql://postgres.<ref>:<password>@aws-0-ap-northeast-2.pooler.supabase.com:6543/postgres
# ──────────────────────────────────────────────────────────────
DATABASE_URL=

# ──────────────────────────────────────────────────────────────
# Supabase Storage
# SERVICE_ROLE_KEY는 서버 전용 시크릿 → .env.local
# ──────────────────────────────────────────────────────────────
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# ──────────────────────────────────────────────────────────────
# Clerk Auth (+ Organizations)
# PUBLISHABLE_KEY는 공개 값, SECRET_KEY/WEBHOOK_SECRET은 시크릿 → .env.local
# ──────────────────────────────────────────────────────────────
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=
CLERK_SECRET_KEY=
CLERK_WEBHOOK_SECRET=

# ──────────────────────────────────────────────────────────────
# Billing — Stripe (Phase 1-C)
# ──────────────────────────────────────────────────────────────
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
NEXT_PUBLIC_STRIPE_PRICE_STANDARD_MONTHLY=

# ──────────────────────────────────────────────────────────────
# AI 생성 (Phase 1-D)
# ──────────────────────────────────────────────────────────────
LLM_API_KEY=
IMAGE_API_KEY=

# ──────────────────────────────────────────────────────────────
# Job queue — Trigger.dev v3 (Phase 2)
# ──────────────────────────────────────────────────────────────
TRIGGER_SECRET_KEY=
TRIGGER_PROJECT_ID=

# ──────────────────────────────────────────────────────────────
# Email — Resend (Phase 2)
# ──────────────────────────────────────────────────────────────
RESEND_API_KEY=
RESEND_FROM_EMAIL=

# ──────────────────────────────────────────────────────────────
# Security — Arcjet
# https://launch.arcjet.com
# ──────────────────────────────────────────────────────────────
ARCJET_KEY=

# ──────────────────────────────────────────────────────────────
# Observability
# ──────────────────────────────────────────────────────────────
NEXT_PUBLIC_LOGGING_LEVEL=info
NEXT_PUBLIC_POSTHOG_KEY=
NEXT_PUBLIC_POSTHOG_HOST=
NEXT_PUBLIC_BETTER_STACK_SOURCE_TOKEN=
NEXT_PUBLIC_BETTER_STACK_INGESTING_HOST=
SENTRY_AUTH_TOKEN=
